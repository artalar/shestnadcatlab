---
import BaseLayout from '../layouts/BaseLayout.astro';
import RequestForm from '../components/RequestForm.astro';
import { SITE } from '../consts';

const services = [
  {
    title: 'C-41',
    text: 'Цветной негатив на стабильной химии. Аккуратно, без сюрпризов в плотности.',
  },
  {
    title: 'Ч/Б',
    text: 'Ручной процесс для чёрно-белой плёнки. Можно обсудить push/pull.',
  },
  {
    title: 'Скан',
    text: 'Потоковый скан с контролем цвета. Нужен hi-res — отметьте в заявке.',
  },
];

const steps = [
  {
    n: '01',
    title: 'Заявка',
    text: 'Коротко опишите плёнку и контакт. Мы ответим в тот же день.',
  },
  {
    n: '02',
    title: 'Сдача',
    text: 'Привозите в лабораторию в Калуге или договариваемся о передаче.',
  },
  {
    n: '03',
    title: 'Готово',
    text: 'Сканы в облаке, плёнка в сливерах. Забираете или отправляем.',
  },
];
---

<BaseLayout description={SITE.description}>
  <section class="hero landing-hero section" aria-labelledby="hero-brand">
    <div class="hero-copy">
      <p class="eyebrow">Фотолаборатория · {SITE.city}</p>
      <h1 id="hero-brand">
        <span class="brand-hero">Шестнадцать</span>
      </h1>
      <p class="lead">
        Проявка и сканирование плёнки — спокойно, по делу, с вниманием к каждому ролику.
      </p>
      <div class="action-row">
        <a class="button" href="#request">Оставить заявку</a>
        <a class="text-link" href="#services">Услуги</a>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="film-plane">
        <div class="film-strip">
          {
            Array.from({ length: 6 }).map((_, index) => (
              <span class="film-frame" style={`--i:${index}`} />
            ))
          }
        </div>
        <p class="film-caption">16 · lab · kaluga</p>
      </div>
    </div>
  </section>

  <section class="section services-section" id="services" aria-labelledby="services-title">
    <div class="section-intro">
      <p class="eyebrow">Услуги</p>
      <h2 id="services-title">Плёнка под контролем.</h2>
      <p class="section-lead">Три опоры лаборатории — без лишнего шума вокруг.</p>
    </div>
    <div class="feature-list services-list">
      {
        services.map((service) => (
          <article>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section process-section" id="process" aria-labelledby="process-title">
    <div class="section-intro">
      <p class="eyebrow">Как сдаём</p>
      <h2 id="process-title">Три шага до сканов.</h2>
    </div>
    <ol class="process-list">
      {
        steps.map((step) => (
          <li>
            <span class="process-n">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section request-section" id="request" aria-labelledby="request-title">
    <div class="request-layout">
      <div class="section-intro">
        <p class="eyebrow">Заявка</p>
        <h2 id="request-title">Оставьте заявку на проявку.</h2>
        <p class="section-lead">
          Напишите контакт и параметры плёнки — ответим и согласуем сдачу в Калуге.
        </p>
      </div>
      <RequestForm />
    </div>
  </section>
</BaseLayout>

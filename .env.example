# Public Supabase project URL and anon key (landing form inserts)
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Single shared secret for the admin panel (one operator)
ADMIN_SECRET=change-me-to-a-long-random-string

# Optional: set to "memory" to run without Supabase (local demo)
# DATA_STORE=memory
